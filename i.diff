+			L.key('ArrowLeft');                     /* the next contestant is called (order: the scores) */
+			var seat = gv.VeDichSeat;
+			L.toast(L.name(seat) + ' bước lên bục Về đích', '');
+			await step();
+			L.key('ArrowLeft');                     /* choose screen */
+			await choosePackage(seat);
+			var starAt = !L.isMe(seat) && L.chance(0.4) ? L.int(1, 3) : 0;
+			await step();
+			L.key('ArrowLeft');                     /* question group, empty bar */
+			await L.sleep(2200);
+			await starWindow(seat, starAt, 1);
+			L.key('ArrowRight');                    /* question 1 text */
+			for (var q = 1; q <= 3; q++) {
+				await step();
+				L.key('ArrowRight');                /* the answer clock */
+				await answerVd(seat, q);
+				await stealVd(seat, q);
+				if (q < 3) { await starWindow(seat, starAt, q + 1); }
+				else { await step(); }
+				L.key('ArrowRight');                /* next question (or the end of the turn) */
+			}
+			await step();
+		}
+		L.key('ArrowLeft');                         /* round over */
+		await L.sleep(1200);
+		L.key('ArrowLeft');                         /* graphics off */
+		await L.sleep(1500);
+	}
+
+	/* three picks: the player with the 20 / 30 buttons, a robot at random */
+	async function choosePackage(seat) {
+		if (!L.isMe(seat)) {
+			for (var i = 0; i < 3; i++) { await L.sleep(L.between(900, 2000)); veDichPick(L.pick([20, 30])); L.changed(); }
+			return;
+		}
+		var box = document.getElementById('luckPick');
+		L.hint('Chọn gói câu hỏi: 3 lần chọn 20 hoặc 30 điểm');
+		box.classList.add('on');
+		await new Promise(function (res) {
+			function pick(v) {
+				veDichPick(v); L.changed();
+				box.querySelector('small').textContent = gv.VeDichValues.join(' - ');
+				if (gv.VeDichValues.length >= 3) { box.onclick = null; res(); }
+			}
+			box.querySelector('small').textContent = '';
+			box.onclick = function (e) { var b = e.target.closest('button[data-v]'); if (b) { pick(parseInt(b.getAttribute('data-v'), 10)); } };
+			if (L.auto) { (function autoPick() { setTimeout(function () { if (gv.VeDichValues.length < 3) { pick(L.pick([20, 30])); autoPick(); } }, 300); })(); }
+		});
+		box.classList.remove('on');
+		L.hint('');
+	}
+
+	/* the moment the star may go on question `index`: a step pause, with the player's button */
+	async function starWindow(seat, starAt, index) {
+		var btn = document.getElementById('luckStar');
+		if (L.isMe(seat) && !gv.IsVeDichStarUsed) {
+			btn.classList.add('on');
+			btn.onclick = function () {
+				veDichPlaceStar(); L.changed();
+				if (gv.IsVeDichStarUsed) { btn.classList.remove('on'); L.toast('Ngôi sao hy vọng đặt vào câu ' + index, 'warn'); }
+			};
+			if (L.auto && L.chance(0.25)) { setTimeout(function () { if (btn.onclick) { btn.onclick(); } }, 200); }
+		}
+		else if (starAt === index) {
+			setTimeout(function () { veDichPlaceStar(); L.changed(); L.toast(L.name(seat) + ' đặt ngôi sao hy vọng!', 'warn'); }, L.between(600, 2000));
+		}
+		await step();
+		btn.classList.remove('on');
+		btn.onclick = null;
+	}
+
+	/* the contestant on stage answers during the clock. The player taps up to 2 / 3 times; each tap
+	 * is only "recorded" - right or wrong shows once the clock has run out */
+	async function answerVd(seat, index) {
+		var ok = null;
+		if (L.isMe(seat)) {
+			var max = gv.VeDichValue >= 30 ? 3 : 2, used = 0, need = threshold(), rolls = [];
+			var stop = L.expect(BAR_VD, function () {
+				if (used >= max || !gv.IsVeDichTimerRunning) { return; }
+				used += 1;
+				rolls.push(L.roll100());
+				L.toast('Đã ghi nhận câu trả lời (' + used + '/' + max + ')', '');
+				if (used >= max) { stop(); }
+			}, 'Nhấn vào thanh câu hỏi để trả lời (tối đa ' + max + ' lần) - kết quả có khi hết giờ', 0.08);
+			await L.until(function () { return gv.IsVeDichTimerDone; });
+			stop();
+			ok = rolls.some(function (r) { return r >= need; });
+			L.record(ok);
+			L.stats.vd.push({ value: gv.VeDichValue, ok: ok, star: veDichStarred() });
+			L.toast(rolls.length ? 'Kết quả quay: ' + rolls.join(', ') + ' (cần ' + need + '+)' : 'Bạn không trả lời', ok ? 'good' : 'bad');
+		}
+		else {
+			var t = Math.min(L.between(3000, 10000), (gv.VeDichSeconds || 15) * 1000 - 800);
+			await L.sleep(t);
+			ok = robotRight(seat, index);
+		}
+		await L.sleep(600);
+		L.key(ok ? 'ArrowUp' : 'ArrowDown');
+		L.toast(L.name(seat) + ': ' + rightWord(ok) + (veDichStarred() ? ' (ngôi sao)' : ''), ok ? 'good' : 'bad');
+	}
+
+	/* wrong: 5 s for a steal - the player by tapping the bar, a robot with 30 %. The player who
+	 * buzzed then taps once more to answer: one roll, it must reach the question's mark */
+	async function stealVd(owner, index) {
+		if (gv.VeDichSequenceCounter != 7) { return; }
+		var thief = null, timers = [];
+		function buzz(seat) {
+			if (thief !== null || gv.VeDichSequenceCounter != 7 || gv.IsVeDichTimerDone) { return; }
+			thief = seat;
+			veDichStealBuzz(seat);
+			L.changed();
+			L.toast(L.name(seat) + ' bấm chuông cướp điểm!', 'warn');
+		}
+		bots(owner).forEach(function (s) { if (L.chance(0.3)) { timers.push(setTimeout(function () { buzz(s); }, L.between(500, 4500))); } });
+		var stop = L.isMe(owner) ? function () {} : L.expect(BAR_VD, function () { buzz(L.me); }, 'Nhấn vào thanh câu hỏi để bấm chuông cướp điểm (5 giây)', 0.04);
+		await L.until(function () { return thief !== null || gv.IsVeDichTimerDone; });
+		stop();
+		timers.forEach(clearTimeout);
+		if (thief === null) { L.toast('Không ai cướp điểm', ''); return; }
+		var ok;
+		if (L.isMe(thief)) {
+			await L.sleep(400);
+			var need = threshold();
+			var tapped = await tapOnce(BAR_VD, 'Nhấn vào thanh câu hỏi để trả lời câu cướp (1 lần, cần quay ' + need + '+)', 5000);
+			if (tapped) { L.toast('Đã ghi nhận câu trả lời', ''); }
+			await L.sleep(1200);
+			var r = tapped ? L.roll100() : 0;
+			ok = L.record(tapped && r >= need);
+			L.toast(tapped ? 'Kết quả quay: ' + r + ' (cần ' + need + '+)' : 'Bạn không trả lời', ok ? 'good' : 'bad');
+		}
+		else { await L.sleep(1400); ok = robotRight(thief, owner + '/' + index); }
+		L.key(ok ? 'ArrowUp' : 'ArrowDown');
+		L.toast(L.name(thief) + ' cướp ' + rightWord(ok).toLowerCase(), ok ? 'good' : 'bad');
+	}
+
+	/* ======================================================================== Câu hỏi phụ */
+
+	async function tieBreak() {
+		var tied = gv.topScoreSeats(gv.Players);
+		if (tied.length < 2) { return; }
+		L.toast('Đồng điểm! Câu hỏi phụ: ' + tied.map(L.name).join(', '), 'warn');
+		switchRound('tb');
+		gv.TieBreakSeats = tied.slice();
+		L.key('ArrowLeft');                         /* who plays */
+		await L.sleep(2200);
+		L.key('ArrowLeft');                         /* the bar */
+		await L.sleep(2600);
+		var meIn = tied.indexOf(L.me) !== -1;
+		for (var q = 0; q < 6 && gv.TieBreakWinner === null; q++) {
+			if (q >= tieBreakQuestionLimit()) { gv.TieBreakQuestions = (gv.TieBreakQuestions || []).concat(gv.TieBreakQuestions || []); }
+			L.key('ArrowRight');                    /* the question: buzzers open, but the music is the signal */
+			var musicOn = false, timers = [];
+			function buzz(seat) {
+				if (gv.TieBreakWinner !== null || gv.TieBreakBuzzSeat !== null) { return; }
+				if (!tieBreakIsPlaying(seat) || tieBreakIsOut(seat)) { return; }
+				tieBreakBuzz(seat);
+				L.changed();
+				if (gv.TieBreakBuzzSeat !== seat) { return; }
+				if (gv.IsTieBreakBuzzEarly) {
+					L.toast(L.name(seat) + ' bấm sớm - bị loại khỏi câu này', 'bad');
+					setTimeout(function () { L.key('ArrowDown'); }, 700);
+				}
+				else {
+					L.key('ArrowUp');
+					L.toast(L.name(seat) + ' bấm chuông đầu tiên và thắng!', 'good');
+				}
+			}
+			var stop = meIn ? L.expect(BAR_KD, function () { buzz(L.me); }, 'Chỉ bấm khi nghe thấy nhạc! Bấm sớm là bị loại khỏi câu này', 0.03) : function () {};
+			await L.sleep(L.between(2000, 8000));
+			if (gv.TieBreakWinner === null && gv.TieBreakSequenceCounter == 3 && gv.TieBreakBuzzSeat === null && tieBreakSeatsLeft().length) {
+				L.key('ArrowRight');                /* the 15 s music: now */
+				musicOn = true;
+				tied.filter(function (s) { return !L.isMe(s); }).forEach(function (s) { timers.push(setTimeout(function () { buzz(s); }, L.between(250, 700))); });
+			}
+			await L.until(function () { return gv.TieBreakWinner !== null || gv.TieBreakSequenceCounter == 5 || (!musicOn && !tieBreakSeatsLeft().length); }, 20000);
+			stop();
+			timers.forEach(clearTimeout);
+			await L.sleep(1800);
+		}
+		L.key('ArrowLeft');                         /* graphics off */
+		await L.sleep(1500);
+	}
+
+	/* ======================================================================== the score summary */
+
+	/* M: every contestant, best first - after Khởi động, VCNV, Tăng tốc and at the end. It opens
+	 * only once the round's graphics are off the screen. */
+	async function summary() {
+		for (var tries = 0; tries < 10 && !isScoreSummaryShowing(); tries++) {
+			await L.sleep(tries ? 800 : 1000);
+			stepScoreSummary(); L.changed();
+		}
+		if (!isScoreSummaryShowing()) { return; }
+		while (isScoreSummaryShowing()) {
+			await L.pause(3, 5);
+			stepScoreSummary(); L.changed();   /* the next contestant; after the last one it closes */
+		}
+		await L.sleep(1200);
+	}
+
+	/* ======================================================================== the match */
+
+	L.play = async function () {
+		/* ?from=vcnv|tt|vd (tests): start at that round, scores at 0 */
+		var from = ['kd', 'vcnv', 'tt', 'vd'].indexOf(new URLSearchParams(location.search).get('from') || 'kd');
+		if (from < 0) { from = 0; }
+		if (from <= 0) { await khoiDong(); await summary(); L.key('ArrowLeft'); }   /* -> Vượt chướng ngại vật */
+		else if (from === 1) { switchRound('vcnv'); }
+		if (from <= 1) { await vcnv(); await summary(); L.key('ArrowLeft'); }       /* -> Tăng tốc */
+		else if (from === 2) { switchRound('tt'); }
+		if (from <= 2) { await tangToc(); await summary(); L.key('ArrowLeft'); }    /* -> Về đích */
+		else { switchRound('vd'); }
+		await veDich();
+		await tieBreak();
+		await summary();                            /* the final standing */
+		return L.result();
+	};
+
+	/* the standing: score, then the tie-break winner */
+	L.result = function () {
+		var w = gv.TieBreakWinner;
+		var list = gv.Players.map(function (p) { return { seat: p.seat, name: gv.displayName(p), score: p.score }; })
+			.sort(function (x, y) { return (y.score - x.score) || ((x.seat === w) ? -1 : (y.seat === w) ? 1 : 0) || (x.seat - y.seat); });
+		var place = 0;
+		list.forEach(function (r, i) { if (i === 0 || r.score !== list[i - 1].score || (i === 1 && list[0].seat === w)) { place = i + 1; } r.place = place; });
+		var me = list.filter(function (r) { return r.seat === L.me; })[0];
+		return { list: list, me: me, stats: L.stats, seed: L.seed };
+	};
+})();
diff --git a/olympia/Scripts/Luck/LuckScreens.js b/olympia/Scripts/Luck/LuckScreens.js
new file mode 100644
index 0000000..cdaae92
--- /dev/null
+++ b/olympia/Scripts/Luck/LuckScreens.js
@@ -0,0 +1,88 @@
+/*
+ * "Bạn có tạch đỉnh Olympia?" - the menu (picture, name, start), the stage fitted to the window,
+ * and the result card (standing, the player's luck, share / play again).
+ */
+(function () {
+	var gv = window.GameVariables, L = window.LUCK;
+	function $(id) { return document.getElementById(id); }
+
+	/* the 1920 x 1080 stage, as large as the window allows, centred */
+	function fit() {
+		var stage = document.querySelector('.stageContainerDiv'), frame = $('luckFrame');
+		if (!stage || !frame) { return; }
+		var s = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
+		stage.style.transform = 'scale(' + s + ')';
+		frame.style.width = Math.round(1920 * s) + 'px';
+		frame.style.height = Math.round(1080 * s) + 'px';
+	}
+
+	function start() {
+		var name = ($('luckName').value || '').trim().replace(/\s+/g, ' ').slice(0, 40) || 'Bạn';
+		try { localStorage.setItem('olympia-luck.name', name); } catch (e) { /* blocked */ }
+		/* this tap lets every later sound play (an iPad plays only elements a tap started) */
+		if (typeof unlockAudioPool === 'function') { unlockAudioPool(16, L.SILENCE); }
+		try { if (navigator.audioSession) { navigator.audioSession.type = 'playback'; } } catch (e) { /* not supported */ }
+		$('luckMenu').classList.add('gone');
+		document.body.classList.add('playing');
+		L.setSeats(name);
+		L.play().then(showResult, function (e) { console.error('[Luck] the match stopped', e); });
+	}
+
+	function headline(me) {
+		if (me.place === 1) { return 'Bạn đã lên đỉnh Olympia - nhờ may thôi'; }
+		if (me.place === 2) { return 'Bạn đã tạch đỉnh Olympia - suýt nữa thì không tạch'; }
+		return 'Bạn đã tạch đỉnh Olympia';
+	}
+
+	function showResult(res) {
+		var me = res.me, st = res.stats;
+		var pct = st.rolls ? Math.round(100 * st.hits / st.rolls) : 0;
+		$('luckResTitle').textContent = headline(me);
+		$('luckResPlace').textContent = 'Hạng ' + me.place + ' · ' + me.score + ' điểm';
+		var ol = $('luckResList');
+		ol.textContent = '';
+		res.list.forEach(function (r) {
+			var li = document.createElement('li');
+			if (r.seat === L.me) { li.className = 'me'; }
+			var a = document.createElement('span'); a.textContent = r.place + '. ' + r.name;
+			var b = document.createElement('b'); b.textContent = r.score;
+			li.appendChild(a); li.appendChild(b);
+			ol.appendChild(li);
+		});
+		var vdRight = st.vd.filter(function (q) { return q.ok; }).length;
+		$('luckResLuck').textContent = 'Bạn đã quay ' + st.rolls + ' lần, trúng ' + st.hits + ' lần (' + pct + '%).' +
+			(st.vd.length ? ' Về đích: đúng ' + vdRight + '/' + st.vd.length + ' câu.' : '') +
+			(pct >= 55 ? ' Hôm nay bạn hên.' : pct <= 40 ? ' Hôm nay không phải ngày của bạn.' : ' Hên xui đúng như tên gọi.');
+		$('luckResult').classList.add('on');
+		L.lastShare = (me.place === 1 ? 'Tôi đã lên đỉnh Olympia nhờ may mắn với ' : 'Tôi đã tạch đỉnh Olympia với ') + me.score + ' điểm (hạng ' + me.place + '/4). Thử nhân phẩm của bạn:';
+	}
+
+	function share() {
+		var url = location.origin + '/olympia-luck/';
+		var text = L.lastShare || 'Bạn có tạch đỉnh Olympia?';
+		if (navigator.share) { navigator.share({ title: 'Bạn có tạch đỉnh Olympia?', text: text, url: url }).catch(function () {}); return; }
+		var all = text + ' ' + url;
+		(navigator.clipboard ? navigator.clipboard.writeText(all) : Promise.reject()).then(function () {
+			$('luckShare').textContent = 'Đã chép đường dẫn';
+		}, function () { prompt('Chép đường dẫn này:', all); });
+	}
+
+	document.addEventListener('DOMContentLoaded', function () {
+		fit();
+		window.addEventListener('resize', fit);
+		L.bindStage(document.querySelector('.stageContainerDiv'));
+		try { $('luckName').value = localStorage.getItem('olympia-luck.name') || ''; } catch (e) { /* blocked */ }
+		$('luckStart').disabled = true;
+		$('luckStart').textContent = 'Đang chuẩn bị phòng thi…';
+		/* the engine is ready once its question files are in (Init.js) */
+		L.until(function () { return gv.VcnvData && gv.VeDichQuestions && gv.Players && gv.Players.length === 4; }, 20000).then(function () {
+			$('luckStart').disabled = false;
+			$('luckStart').textContent = 'Vào thi';
+			if (L.auto) { start(); }
+		});
+		$('luckForm').addEventListener('submit', function (e) { e.preventDefault(); if (!$('luckStart').disabled) { start(); } });
+		$('luckNext').addEventListener('click', L.skip);
+		$('luckShare').addEventListener('click', share);
+		$('luckAgain').addEventListener('click', function () { location.href = location.pathname; });
+	});
+})();
diff --git a/olympia/Styles/luck.css b/olympia/Styles/luck.css
new file mode 100644
index 0000000..23d38c7
--- /dev/null
+++ b/olympia/Styles/luck.css
@@ -0,0 +1,278 @@
+/* =====================================================================================
+   "Bạn có tạch đỉnh Olympia?" (/olympia-luck/) - the page around the Olympia 26 stage: the menu
+   (the show's opening card), the stage fitted to the window, the hints / toasts / "Tiếp ›" over it,
+   and the result card. The stage itself is olympia.css + o26.css as on default.html.
+   ===================================================================================== */
+html, body.luckPage {
+	margin: 0;
+	width: 100%;
+	height: 100%;
+	overflow: hidden;
+	background: #050a1c;
+	font-family: Nunito, "Segoe UI", system-ui, sans-serif;
+	color: #f4f6ff;
+}
+
+/* the stage: 1920 x 1080 scaled by LuckScreens.js fit(), centred */
+#luckFrame {
+	position: fixed;
+	left: 50%;
+	top: 50%;
+	transform: translate(-50%, -50%);
+	overflow: hidden;
+}
+#luckFrame .stageContainerDiv {
+	transform-origin: 0 0;
+	touch-action: manipulation;
+}
+#luckFrame .authorityWarningDiv { display: none !important; }
+
+/* where the player may tap: the elements themselves take the tap, a soft glow says so */
+#luckFrame .questionBarDiv,
+#luckFrame .vcnvQuestionDiv,
+#luckFrame .vcnvPictureDiv,
+#luckFrame .vcnvBoardDiv [class*="vcnvStrip"],
+#luckFrame .ttDiv,
+#luckFrame .vdQuestionGroup { pointer-events: auto; }
+#luckFrame .luckGlow { cursor: pointer; animation: luckGlow 1.1s ease-in-out infinite alternate; }
+@keyframes luckGlow {
+	from { filter: drop-shadow(0 0 0 rgba(255, 214, 90, 0)); }
+	to { filter: drop-shadow(0 0 18px rgba(255, 214, 90, .95)); }
+}
+
+/* ---------- over the stage ---------- */
+#luckHint {
+	position: fixed;
+	left: 50%;
+	bottom: max(14px, env(safe-area-inset-bottom));
+	transform: translate(-50%, 20px);
+	max-width: min(760px, calc(100vw - 32px));
+	padding: 10px 18px;
+	border-radius: 999px;
+	background: rgba(8, 14, 40, .86);
+	border: 1px solid rgba(255, 214, 90, .5);
+	color: #ffe9a8;
+	font-weight: 800;
+	font-size: clamp(13px, 1.6vw, 17px);
+	text-align: center;
+	opacity: 0;
+	pointer-events: none;
+	transition: opacity .25s, transform .35s cubic-bezier(.16, 1, .3, 1);
+	z-index: 20;
+}
+#luckHint.on { opacity: 1; transform: translate(-50%, 0); }
+
+#luckToasts {
+	position: fixed;
+	right: 14px;
+	top: 14px;
+	display: flex;
+	flex-direction: column;
+	align-items: flex-end;
+	gap: 6px;
+	max-width: min(360px, calc(100vw - 28px));
+	pointer-events: none;
+	z-index: 20;
+}
+.luckToast {
+	padding: 8px 12px;
+	border-radius: 10px;
+	background: rgba(8, 14, 40, .88);
+	border-left: 4px solid #8aa0d8;
+	font-size: 14px;
+	font-weight: 700;
+	animation: luckIn .35s cubic-bezier(.16, 1, .3, 1) both;
+	transition: opacity .5s;
+}
+.luckToast.good { border-left-color: #3fd28b; }
+.luckToast.bad { border-left-color: #ff6b5e; }
+.luckToast.warn { border-left-color: #ffcf4a; }
+.luckToast.out { opacity: 0; }
+@keyframes luckIn { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }
+
+#luckCounter {
+	position: fixed;
+	left: 14px;
+	top: 14px;
+	padding: 8px 14px;
+	border-radius: 10px;
+	background: rgba(8, 14, 40, .88);
+	font-weight: 900;
+	font-size: 16px;
+	display: none;
+	z-index: 20;
+}
+#luckCounter.on { display: block; }
+
+#luckNext {
+	position: fixed;
+	right: 14px;
+	bottom: max(14px, env(safe-area-inset-bottom));
+	overflow: hidden;
+	padding: 10px 18px 12px;
+	border: 1px solid rgba(255, 255, 255, .25);
+	border-radius: 12px;
+	background: rgba(8, 14, 40, .88);
+	color: #fff;
+	font: 800 15px Nunito, sans-serif;
+	cursor: pointer;
+	display: none;
+	z-index: 21;
+}
+#luckNext.on { display: block; }
+#luckNext:active { transform: scale(.97); }
+#luckNext i {
+	position: absolute;
+	left: 0;
+	right: 0;
+	bottom: 0;
+	height: 3px;
+	background: #ffcf4a;
+	transform-origin: 0 50%;
+}
+
+#luckPick, #luckStar {
+	position: fixed;
+	left: 50%;
+	top: 16px;
+	transform: translateX(-50%);
+	z-index: 21;
+	display: none;
+}
+#luckPick.on { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 14px; background: rgba(8, 14, 40, .9); border: 1px solid rgba(255, 214, 90, .5); }
+#luckPick p { margin: 0 6px 0 0; font-weight: 800; }
+#luckPick small { color: #ffcf4a; margin-left: 6px; }
+#luckPick button, #luckStar, #luckMenu button, #luckResult button {
+	min-height: 42px;
+	padding: 0 18px;
+	border: 0;
+	border-radius: 10px;
+	background: linear-gradient(#ffd85a, #f0a91c);
+	color: #2b1700;
+	font: 900 15px Nunito, sans-serif;
+	cursor: pointer;
+}
+#luckPick button:active, #luckStar:active, #luckMenu button:active, #luckResult button:active { transform: translateY(1px) scale(.98); }
+#luckStar.on { display: block; top: auto; bottom: max(14px, env(safe-area-inset-bottom)); left: 14px; transform: none; }
+
+/* ---------- the menu: the show's opening card ---------- */
+#luckMenu {
+	position: fixed;
+	inset: 0;
+	z-index: 30;
+	display: grid;
+	grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
+	align-items: center;
+	gap: clamp(16px, 3vw, 40px);
+	padding: 24px clamp(16px, 4vw, 56px);
+	background: radial-gradient(ellipse at 35% 45%, #12305a 0%, #071330 55%, #040917 100%);
+	overflow-y: auto;
+	transition: opacity .5s, visibility .5s;
+}
+#luckMenu.gone { opacity: 0; visibility: hidden; }
+#luckMenu .menuArt {
+	width: 100%;
+	height: auto;
+	max-height: calc(100dvh - 48px);
+	object-fit: contain;
+	border-radius: 16px;
+	box-shadow: 0 30px 80px -30px rgba(0, 0, 0, .9);
+	-webkit-mask-image: radial-gradient(ellipse at center, #000 70%, transparent 100%);
+	mask-image: radial-gradient(ellipse at center, #000 70%, transparent 100%);
+}
+#luckForm {
+	grid-column: 2;
+	padding: 22px 22px 18px;
+	border-radius: 18px;
+	background: rgba(6, 12, 34, .82);
+	border: 1px solid rgba(255, 214, 90, .35);
+	box-shadow: 0 24px 60px -24px rgba(0, 0, 0, .8);
+	-webkit-backdrop-filter: blur(6px);
+	backdrop-filter: blur(6px);
+}
+#luckForm h1 { margin: 0 0 8px; font-size: 26px; font-weight: 900; line-height: 1.15; color: #ffd85a; }
+#luckForm h1 s { color: #9aa6c8; text-decoration-thickness: 3px; }
+#luckForm p { margin: 0 0 10px; font-size: 14px; line-height: 1.5; color: #d7ddf3; }
+#luckForm ul { margin: 0 0 14px; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 13px; line-height: 1.45; color: #c9d1ec; }
+#luckForm li b { display: inline-block; min-width: 86px; color: #ffd85a; }
+#luckForm label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 800; }
+#luckForm .row { display: flex; gap: 8px; }
+#luckForm input {
+	flex: 1;
+	min-width: 0;
+	height: 42px;
+	padding: 0 12px;
+	border: 1px solid rgba(255, 255, 255, .25);
+	border-radius: 10px;
+	background: rgba(255, 255, 255, .08);
+	color: #fff;
+	font: 700 15px Nunito, sans-serif;
+}
+#luckForm input:focus { outline: 2px solid #ffd85a; outline-offset: 1px; }
+#luckForm button:disabled { opacity: .6; cursor: wait; }
+#luckForm small { display: block; margin-top: 10px; font-size: 12px; color: #9aa6c8; }
+#luckForm small a { color: #ffd85a; }
+
+/* ---------- the result ---------- */
+#luckResult {
+	position: fixed;
+	inset: 0;
+	z-index: 30;
+	display: none;
+	place-items: center;
+	padding: 16px;
+	background: rgba(3, 6, 18, .72);
+}
+#luckResult.on { display: grid; animation: luckIn .5s cubic-bezier(.16, 1, .3, 1) both; }
+#luckResult .card {
+	width: min(460px, 100%);
+	padding: 22px;
+	border-radius: 18px;
+	background: #0b1433;
+	border: 1px solid rgba(255, 214, 90, .4);
+	box-shadow: 0 30px 80px -30px #000;
+}
+#luckResult .eyebrow { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #9aa6c8; }
+#luckResult h2 { margin: 6px 0 4px; font-size: 24px; font-weight: 900; line-height: 1.2; color: #ffd85a; }
+#luckResPlace { margin: 0 0 12px; font-size: 18px; font-weight: 800; }
+#luckResList { margin: 0 0 12px; padding: 0; list-style: none; display: grid; gap: 4px; }
+#luckResList li { display: flex; justify-content: space-between; padding: 8px 12px; border-radius: 10px; background: rgba(255, 255, 255, .05); font-weight: 700; }
+#luckResList li.me { background: rgba(255, 216, 90, .16); color: #ffe9a8; }
+#luckResList b { font-variant-numeric: tabular-nums; }
+#luckResLuck { margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #d7ddf3; }
+#luckResult .row { display: flex; gap: 8px; flex-wrap: wrap; }
+#luckAgain { background: rgba(255, 255, 255, .1) !important; color: #fff !important; }
+
+/* a phone held upright: the stage is tiny - ask to turn it */
+@media (max-aspect-ratio: 1/1) {
+	body.playing::after {
+		content: "Xoay ngang điện thoại để nhìn rõ hơn";
+		position: fixed;
+		left: 50%;
+		top: 12px;
+		transform: translateX(-50%);
+		padding: 6px 12px;
+		border-radius: 999px;
+		background: rgba(8, 14, 40, .9);
+		font-size: 13px;
+		font-weight: 800;
+		z-index: 22;
+	}
+}
+@media (max-width: 760px) {
+	#luckMenu { grid-template-columns: minmax(0, 1fr); align-content: start; }
+	#luckMenu .menuArt { max-height: none; }
+	#luckForm { grid-column: 1; }
+	#luckForm ul { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+	#luckFrame .luckGlow, .luckToast, #luckResult.on { animation: none; }
+}
+/* a phone held sideways: little height - the rules list goes, the card gets tighter */
+@media (max-height: 520px) {
+	#luckMenu { align-items: safe center; padding-block: 12px; }
+	#luckForm { padding: 14px 16px 12px; }
+	#luckForm h1 { font-size: 20px; }
+	#luckForm ul { display: none; }
+	#luckForm p { font-size: 13px; }
+}

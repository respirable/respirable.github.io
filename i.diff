+			L.toast(queue.map(L.name).join(', ') + ': SAI - bị loại khỏi VCNV', 'bad');
+		}
+		L.changed();
+	}
+
+	/* the picture: the player may signal at any row step */
+	var stopPicture = null;
+	function offerPicture() {
+		if (stopPicture || vcnvIsEliminated(L.me)) { return; }

new file mode 100644
index 0000000..0fea9f9
--- /dev/null
+++ b/olympia-luck/questions/cauhoiphu.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- "Bạn có tạch đỉnh Olympia?" - Câu hỏi phụ: chỉ là bài kiểm tra phản xạ. Đợi nhạc rồi mới bấm. -->
+<cauhoiphu>
+  <question><text>Câu hỏi này không có nội dung. Hãy đợi nhạc.</text><answer>Đợi nhạc</answer></question>
+  <question><text>Vẫn không có nội dung. Lần này đừng bấm sớm.</text><answer>Đợi nhạc</answer></question>
+  <question><text>Câu cuối. Robot không biết đọc nhưng biết nghe nhạc.</text><answer>Đợi nhạc</answer></question>
+  <question><text>Nếu bạn đọc được dòng này, có lẽ bạn đã bấm sớm quá nhiều lần.</text><answer>Đợi nhạc</answer></question>
+</cauhoiphu>
diff --git a/olympia-luck/questions/khoidong.xml b/olympia-luck/questions/khoidong.xml
new file mode 100644
index 0000000..5c74daa
--- /dev/null
+++ b/olympia-luck/questions/khoidong.xml
@@ -0,0 +1,50 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- "Bạn có tạch đỉnh Olympia?" - Khởi động. Câu hỏi chỉ để đọc cho vui: kết quả là quay số. -->
+<khoidong>
+  <individual seat="1">
+    <question><text>Bạn đang trả lời câu này bằng kiến thức hay bằng ngón tay?</text><answer>Ngón tay</answer></question>

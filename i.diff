+	};
+	function glow() {
+		document.querySelectorAll('.luckGlow').forEach(function (el) { el.classList.remove('luckGlow'); });
+		active.forEach(function (e) { document.querySelectorAll(e.sel).forEach(function (el) { el.classList.add('luckGlow'); }); });

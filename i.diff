+		}, 'Nhấn vào ảnh gợi ý để xin trả lời chướng ngại vật (đúng 10%)', 0.004);
+	}
+	function closePicture() { if (stopPicture) { stopPicture(); stopPicture = null; } }
+
+	/* a robot now and then "wants" to signal; it really does with 30 % */

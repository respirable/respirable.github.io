+		for (var r = 0; r < 4 && !vcnvOver(); r++) {
+			var chooser = null;
+			for (var k = 0; k < 4 && chooser === null; k++) { var s = order[(turn + k) % 4]; if (!vcnvIsEliminated(s)) { chooser = s; turn = (turn + k + 1) % 4; } }

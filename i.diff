+			await guardGuess();
+			if (vcnvOver()) { break; }
+			vcnvSelectRow(row);
+			L.changed();
+			L.toast(L.name(chooser) + ' chọn hàng ngang số ' + row, '');
+			await playRow(row);
+		}
+		if (!vcnvOver() && vcnvCenterAvailable()) {
+			await step();
+			await guardGuess();
+			if (!vcnvOver()) {
+				vcnvSelectRow(VCNV_CENTER);
+				L.changed();
+				L.toast('Ô trung tâm', '');
+				await playRow(VCNV_CENTER);
+			}
+		}
+		if (!vcnvOver() && vcnvFinalWindowAvailable()) {

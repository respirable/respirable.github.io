+		var picked = null;
+		var stop = L.expect(closed.map(function (n) { return '.vcnvBoardDiv .vcnvStrip' + n; }).join(','), function (el) {
+			var m = /vcnvStrip(\d)/.exec(el.className);
+			if (m) { picked = parseInt(m[1], 10); }
+		}, 'Lượt của bạn: nhấn vào một hàng ngang để chọn', 0.3);
